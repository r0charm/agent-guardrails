#!/usr/bin/env bash
# Regression suite. Run from anywhere: scripts/test
#
# Runs guards/<name>/cases against that guard alone, so dropping one guard never
# fails another's cases. Then guards/known-leaks through every guard, which must
# all stay silent. Then the wiring.
cd "$(dirname "$0")/.." || exit 1
pass=0; fail=0; known=0

# check GUARD EXPECTED COMMAND; an empty GUARD runs every guard.
check() {
  local out rc got
  if [ -n "$1" ]; then out=$(scripts/guard --only "$1" "$3" 2>&1); rc=$?
  else out=$(scripts/guard "$3" 2>&1); rc=$?; fi
  if [ "$rc" -eq 2 ]; then got=DENY
  elif printf '%s' "$out" | grep -q '"ask"'; then got=ASK
  else got=PASS; fi
  if [ "$got" = "$2" ]; then pass=$((pass+1))
  else fail=$((fail+1)); echo "FAIL ${1:-all} expected=$2 got=$got: $3"; fi
}

# Comments and blank lines skipped; anything else is OUTCOME, a space, COMMAND.
lines() { grep -v -e '^#' -e '^$' "$1"; }

for dir in guards/*/; do
  name=$(basename "$dir")
  for f in rules cases policy.md; do
    [ -f "$dir$f" ] || { fail=$((fail+1)); echo "FAIL $name has no $f"; }
  done
  [ -f "${dir}cases" ] || continue
  while IFS= read -r line; do
    outcome="${line%% *}"
    case "$outcome" in
      DENY|ASK|PASS) check "$name" "$outcome" "${line#* }" ;;
      *) fail=$((fail+1)); echo "FAIL $name: no outcome on: $line" ;;
    esac
  done < <(lines "${dir}cases")
done

while IFS= read -r line; do
  check "" PASS "$line"
  known=$((known+1))
done < <(lines guards/known-leaks)

# wiring: every harness calls the one runner, and it is executable
[ -x scripts/guard ] || { fail=$((fail+1)); echo "FAIL scripts/guard is not executable"; }
python3 -c 'import json; json.load(open("hooks/hooks.json"))' \
  || { fail=$((fail+1)); echo "FAIL hooks/hooks.json is not valid JSON"; }
grep -q 'scripts/guard"' hooks/hooks.json || { fail=$((fail+1)); echo "FAIL hooks/hooks.json does not call scripts/guard"; }
for w in .opencode/plugin.ts .pi/plugin.ts; do
  grep -q 'path.join(scripts, "guard")' "$w" || { fail=$((fail+1)); echo "FAIL $w does not call scripts/guard"; }
done

echo "$pass passed, $fail failed, $known known leaks"
[ "$fail" -eq 0 ]
