#!/usr/bin/env bash
# Regression suite. Run from anywhere: scripts/test
# Each case is guard, command, expected outcome (DENY, ASK or PASS).
cd "$(dirname "$0")" || exit 1
pass=0; fail=0
t() {
  local out rc got
  out=$(./"$1" "$2" 2>&1); rc=$?
  if [ "$rc" -eq 2 ]; then got=DENY
  elif printf '%s' "$out" | grep -q '"ask"'; then got=ASK
  else got=PASS; fi
  if [ "$got" = "$3" ]; then pass=$((pass+1))
  else fail=$((fail+1)); echo "FAIL $1 expected=$3 got=$got: $2"; fi
}

# git: denied, because they remove the recovery net
t git-guard "git reflog expire --all" DENY
t git-guard "git gc --prune=now" DENY
t git-guard "git filter-branch x" DENY
t git-guard "git update-ref -d refs/x" DENY
# git: asked
t git-guard "git push origin main" ASK
t git-guard "git push --force" ASK
t git-guard "git reset --hard" ASK
t git-guard "git clean -fd" ASK
t git-guard "git branch -D feat" ASK
t git-guard "git restore src/a.ts" ASK
t git-guard "git rebase main" ASK
t git-guard "git commit --amend" ASK
t git-guard "git stash drop" ASK
t git-guard "git worktree remove --force w" ASK
# git: the everyday path stays silent
t git-guard "git status" PASS
t git-guard "git log" PASS
t git-guard "git commit -m x" PASS
t git-guard "git diff HEAD" PASS
t git-guard "git fetch origin" PASS
# git: global options before the verb, and chains
t git-guard "git -C repo push" ASK
t git-guard "cd x && git push origin main" ASK
t git-guard "git --no-pager reset --hard HEAD~1" ASK
t git-guard "git push -f origin feat" ASK
t git-guard "git checkout -- src/a.ts" ASK
t git-guard "git branch --delete --force feat" ASK
# git: a verb ended by a quote or a shell separator rather than a space
t git-guard "git push;" ASK
t git-guard "git push && echo done" ASK
t git-guard "bash -c 'git push'" ASK
t git-guard "sh -c \"git rebase\"" ASK
t git-guard "(git reset --hard)" ASK
t git-guard "git branch -D feat;" ASK
t git-guard "bash -c 'git stash push'" PASS
# git: verbs that appear as arguments, messages or the safe lowercase flag
t git-guard "git stash push -m wip" PASS
t git-guard "git branch -d merged" PASS
t git-guard "git commit -m 'fix rebase docs'" PASS
t git-guard "git log --grep=push" PASS
t git-guard "git config --get remote.origin.pushurl" PASS
t git-guard "git checkout -b feat" PASS
t git-guard "git clean -n" PASS
t git-guard "git restore --staged src/a.ts" PASS

# kubernetes: denied
t kubernetes-guard "kubectl delete namespace prod" DENY
t kubernetes-guard "kubectl delete pvc d" DENY
t kubernetes-guard "kubectl delete -n ns pvc d" DENY
t kubernetes-guard "kubectl delete crd w.example.com" DENY
t kubernetes-guard "kubectl delete po --all" DENY
t kubernetes-guard "kubectl delete po --force --grace-period=0 x" DENY
# kubernetes: capability grants
t kubernetes-guard "kubectl exec -it p -- sh" ASK
t kubernetes-guard "kubectl attach p" ASK
t kubernetes-guard "kubectl port-forward svc/db 5432" ASK
t kubernetes-guard "kubectl proxy" ASK
t kubernetes-guard "kubectl cp a p:/b" ASK
# kubernetes: secret reads and state changes
t kubernetes-guard "kubectl get secret s -o yaml" ASK
t kubernetes-guard "kubectl --context c delete deploy/a" ASK
t kubernetes-guard "kubectl apply -f x" ASK
t kubernetes-guard "kubectl scale deploy/a --replicas=0" ASK
t kubernetes-guard "kubectl config use-context prod" ASK
t kubernetes-guard "helm upgrade a ." ASK
# kubernetes: verbs after a quote or a shell separator, not only a space
t kubernetes-guard "bash -c 'helm upgrade a .'" ASK
t kubernetes-guard "cd x&&helm install a ." ASK
t kubernetes-guard "sh -c \"kubectl proxy\"" ASK
t kubernetes-guard "kubectl drain n1;" ASK
t kubernetes-guard "kubectl get pods -l 'app=delete'" PASS
# kubernetes: reads, including ones whose arguments carry mutation words
t kubernetes-guard "kubectl get pods" PASS
t kubernetes-guard "kubectl auth can-i create pods" PASS
t kubernetes-guard "kubectl get pods -l app=delete-me" PASS
t kubernetes-guard "kubectl get events --field-selector reason=Created" PASS
t kubernetes-guard "kubectl logs deploy/scaler" PASS
t kubernetes-guard "kubectl describe deploy/label-printer" PASS
t kubernetes-guard "kubectl get secret s" PASS

# data: denied
t data-guard "aws dynamodb delete-table --table-name t" DENY
t data-guard "aws s3 rb s3://b" DENY
t data-guard "aws rds delete-db-instance --db-instance-identifier d" DENY
t data-guard "db.dropDatabase()" DENY
t data-guard "db.u.deleteMany({})" DENY
t data-guard "mongorestore --drop d" DENY
# data: the ones that do not read as destructive
t data-guard "aws s3 sync . s3://b --delete" ASK
t data-guard "aws dynamodb put-item --table-name t" ASK
t data-guard "aws s3 mv s3://a s3://b" ASK
# data: secrets out, data out, ordinary writes
t data-guard "aws secretsmanager get-secret-value --secret-id s" ASK
t data-guard "mongodump --uri u" ASK
t data-guard "db.u.drop()" ASK
# data: reads, including buckets and keys named after verbs
t data-guard "aws s3 ls s3://my-delete-bucket" PASS
t data-guard "aws s3 ls s3://backups/drop-2026" PASS
t data-guard "aws s3api head-object --bucket b --key drop.json" PASS
t data-guard "aws dynamodb scan --table-name t" PASS
t data-guard "db.u.find({})" PASS
t data-guard "aws rds describe-db-instances" PASS

# cloud: denied
t cloud-guard "aws ec2 terminate-instances --instance-ids i" DENY
t cloud-guard "aws iam attach-role-policy --role-name r" DENY
t cloud-guard "aws kms schedule-key-deletion --key-id k" DENY
t cloud-guard "aws eks update-kubeconfig --name c" DENY
t cloud-guard "aws cloudformation delete-stack --stack-name s" DENY
# cloud: credentials, role changes, the rollback you did not know you were deleting
t cloud-guard "aws ecr get-login-password" ASK
t cloud-guard "aws sts assume-role --role-arn a" ASK
t cloud-guard "aws ecr batch-delete-image --repository-name r" ASK
t cloud-guard "terraform apply" ASK
t cloud-guard "terraform state rm x" ASK
# cloud: reads, including resources named after verbs
t cloud-guard "aws ec2 describe-instances --filters Name=tag:Name,Values=delete-me" PASS
t cloud-guard "aws ecr describe-images --repository-name create-service" PASS
t cloud-guard "terraform plan" PASS
t cloud-guard "aws iam list-roles" PASS
t cloud-guard "aws sts get-caller-identity" PASS

# fs: deletes git cannot recover
t fs-guard "rm -rf .claude/worktrees" ASK
t fs-guard "rm -rf ../app-worktree-feat" ASK
t fs-guard "find . -path '*worktree*' -delete" ASK
# fs: ordinary deletes stay silent
t fs-guard "rm -rf node_modules" PASS
t fs-guard "rm build/app.js" PASS
t fs-guard "confirm worktree" PASS

# wiring: every guard on disk is executable and named by each harness's wiring
cd .. || exit 1
python3 -c 'import json; json.load(open("hooks/hooks.json"))' \
  || { fail=$((fail+1)); echo "FAIL hooks/hooks.json is not valid JSON"; }
for g in scripts/*-guard; do
  n=$(basename "$g")
  [ -x "$g" ] || { fail=$((fail+1)); echo "FAIL $n is not executable"; }
  for w in hooks/hooks.json .opencode/plugin.ts .pi/plugin.ts; do
    grep -q "$n" "$w" || { fail=$((fail+1)); echo "FAIL $n missing from $w"; }
  done
done

echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
