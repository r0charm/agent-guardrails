# Guards the document and key-value stores: MongoDB and DynamoDB. See policy.md.
#
# Mongo is matched by method, `.name(`, so a field or key named after a verb,
# `sort({deleteMany: 1})`, stays silent. DynamoDB is matched by subcommand after
# `dynamodb`, as the AWS CLI spells it.

# A Mongo method call: `.name(`, with optional space before the paren.
M='\.'
P=' *\('
T=$'\t'

DENY=(
  # The data itself, all of it.
  "dynamodb +delete-table${T}deletes the table and everything in it"
  "${M}dropDatabase${P}|(runCommand|adminCommand)${P} *\{ *dropDatabase${T}drops the entire database"
  "${M}(deleteMany|remove)${P} *\{ *\}${T}an empty filter matches every document in the collection"
  "(mongorestore|mongoimport) +.*--drop${T}drops each collection before loading, so a wrong file replaces good data"

  # The recovery net. Everything below is survivable while a backup or point in
  # time recovery holds the old data; these are what remove it.
  "dynamodb +delete-backup${T}deletes a backup, which is what a restore would have needed"
  "dynamodb +update-continuous-backups.*Enabled=false${T}turns off point in time recovery, so nothing before now can be restored"
)

ASK=(
  # The ones that do not read as destructive and are.
  "dynamodb +put-item${T}replaces the whole item rather than merging, so unlisted attributes are dropped"
  "dynamodb +update-time-to-live${T}sets an attribute that deletes items later, unattended"
  "${M}aggregate${P}.*\\\$(out|merge)${T}writes the pipeline's output over a collection"
  "${M}renameCollection${P}${T}renames a collection, and with dropTarget drops the one it lands on"

  # Data out.
  "mongo(dump|export)${T}copies the data out to disk"
  "dynamodb +export-table-to-point-in-time${T}copies the table out to S3"

  # Writes, by method or subcommand.
  "${M}(drop|dropIndex|dropIndexes|deleteMany|deleteOne|remove|updateMany|updateOne|insertMany|insertOne|replaceOne|findOneAndDelete|findOneAndReplace|findOneAndUpdate|findAndModify|bulkWrite)${P}${T}changes collection data"
  "(runCommand|adminCommand)${P} *\{ *(drop|delete|update|insert|findAndModify|renameCollection|shutdown)${T}runs a command that changes data or the server"
  "mongoimport${T}writes documents into a collection"
  "dynamodb +(delete-item|batch-write-item|update-item|transact-write-items|update-table|restore-table|import-table)${T}changes table data or shape"
  # PartiQL reads stay silent; a write, or statements from a file the guard
  # cannot read, asks.
  "dynamodb +(batch-)?execute-(statement|transaction).*(delete +from|update +[^ ]+ +(set|remove)|insert +into|file://)${T}runs a PartiQL statement that changes data"
  "dynamodb +update-continuous-backups${T}changes point in time recovery for the table"

  # Access and the server itself.
  "${M}(createUser|updateUser|dropUser|dropAllUsers|grantRolesToUser|revokeRolesFromUser|createRole|dropRole)${P}${T}changes who can do what in the database"
  "${M}(shutdownServer|fsyncLock)${P}${T}stops or freezes the server"
  "dynamodb +(put|delete)-resource-policy${T}changes who can reach the table"
)

# Commands this guard looks at at all, so it stays out of the others' way.
SCOPE='(^|[^[:alnum:]_-])(mongo[a-z]*|db\.|db\[|dynamodb)|(runCommand|adminCommand|getSiblingDB|getCollection)'
