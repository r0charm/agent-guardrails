# Guards DynamoDB. See policy.md.
#
# Matched by the subcommand after `dynamodb`, as the AWS CLI spells it, so a
# table named `delete-me` stays silent.

T=$'\t'

DENY=(
  # The data itself.
  "dynamodb +delete-table${T}deletes the table and everything in it"

  # The recovery net. Everything below is survivable while a backup or point in
  # time recovery holds the old data; these are what remove it.
  "dynamodb +delete-backup${T}deletes a backup, which is what a restore would have needed"
  "dynamodb +update-continuous-backups.*Enabled=false${T}turns off point in time recovery, so nothing before now can be restored"
)

ASK=(
  # The ones that do not read as destructive and are.
  "dynamodb +put-item${T}replaces the whole item rather than merging, so unlisted attributes are dropped"
  "dynamodb +update-time-to-live${T}sets an attribute that deletes items later, unattended"

  # Data out.
  "dynamodb +export-table-to-point-in-time${T}copies the table out to S3"

  # Writes.
  "dynamodb +(delete-item|batch-write-item|update-item|transact-write-items|update-table|restore-table|import-table)${T}changes table data or shape"
  # PartiQL reads stay silent; a write, or statements from a file the guard
  # cannot read, asks.
  "dynamodb +(batch-)?execute-(statement|transaction).*(delete +from|update +[^ ]+ +(set|remove)|insert +into|file://)${T}runs a PartiQL statement that changes data"
  "dynamodb +update-continuous-backups${T}changes point in time recovery for the table"

  # Access.
  "dynamodb +(put|delete)-resource-policy${T}changes who can reach the table"
)

# Commands this guard looks at at all, so it stays out of the others' way.
SCOPE='(^|[^[:alnum:]_-])dynamodb([^[:alnum:]_-]|$)'
