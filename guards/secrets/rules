# Guards credentials: the stores that hand them out, and the files that hold
# them. See policy.md.
#
# A secret printed once sits in the session transcript from then on, so reads
# ask here even though they change nothing.

S="(^|[ '\";&|(])"
E="( |;|&|\)|\$)"
T=$'\t'
# Files that hold a credential. Private keys only: a `.pub` is meant to be read.
# `.env` and its environment variants, not `.env.example`.
F='(\.aws/credentials|\.ssh/id_[a-z0-9]+|\.netrc|\.git-credentials|\.npmrc|\.pgpass|\.docker/config\.json|\.env(\.(local|dev|development|prod|production|staging|test))?)( |;|&|\||\)|$)'
# Commands that print, copy or send a file's contents.
R='(cat|less|more|head|tail|bat|strings|xxd|od|base64|grep|rg|awk|sed|jq|cp|scp|rsync|curl)'

DENY=(
  # The recovery window is the net for a deleted secret.
  "${S}secretsmanager +delete-secret.*--force-delete-without-recovery${T}deletes the secret with no recovery window, so whatever authenticates with it breaks for good"
)

ASK=(
  # Reads that print a credential.
  "${S}secretsmanager +(batch-)?get-secret-value${E}${T}prints the secret, which then sits in the session transcript"
  "${S}ssm +get-parameter.*--with-decryption${T}prints the decrypted value into the session transcript"
  "${S}kms +decrypt${E}${T}prints decrypted plaintext into the session transcript"
  "${S}configure +(get +[^ ]*(secret|access_key|session_token)|export-credentials)${T}prints AWS credentials into the session transcript"
  "${S}${R}( +[^ ]+)* +([^ ]*[/=@])?${F}${T}reads a file that holds a credential, which then sits in the session transcript"

  # Changes to what everything else authenticates with.
  "${S}secretsmanager +(delete-secret|put-secret-value|update-secret|rotate-secret|put-resource-policy|delete-resource-policy)${E}${T}changes a secret that running services authenticate with"
  "${S}ssm +(put-parameter|delete-parameters?)${E}${T}changes configuration that running services read"
)

# Commands this guard looks at at all, so it stays out of the others' way.
SCOPE='(secretsmanager|ssm|kms|configure|\.aws/|\.ssh/|\.netrc|\.git-credentials|\.npmrc|\.pgpass|\.docker/|\.env)'
