# Guards the AWS control plane: EC2, IAM, ECR, CloudFormation, EKS.
# See policy.md. Data services are the data guard's, not this one's.

DENY=(
  $'ec2 +terminate-instances\tterminates instances, and instance storage with them'
  $'cloudformation +delete-stack\tdeletes every resource the stack owns'
  $'kms +schedule-key-deletion\tschedules key deletion, after which anything it encrypted is unreadable'
  $'iam +(create-access-key|create-user|attach-(user|role|group)-policy|put-(user|role|group)-policy|delete-)\tchanges who can do what, which is how a small mistake becomes a large one'
  $'eks +update-kubeconfig\tappends duplicate ARN-named entries to the kubeconfig on every run, since the contexts already exist'
  $'ecr +delete-repository +.*--force\tdeletes the repository and every image in it, including whatever is deployed'
)

ASK=(
  # A read that hands over a credential.
  $'ecr +get-login-password\tprints a registry credential into the session transcript'
  $'sts +assume-role\tswitches to another role, so what follows runs with different permissions than this session started with'
  $'eks +get-token\tprints a cluster credential'

  # Deleting an image the cluster is running is how a rollback stops being
  # possible, and it does not look destructive.
  $'ecr +batch-delete-image\tdeletes images, which is what a rollback would have needed'
  $'ecr +put-lifecycle-policy\tsets rules that delete images later, unattended'

  $'ec2 +(run-instances|stop-instances|reboot-instances|modify-|create-|delete-|revoke-|authorize-)\tchanges compute or its network exposure'
  $'cloudformation +(create-stack|update-stack|execute-change-set)\tprovisions or changes infrastructure'
  $'(lambda|apigateway|events|ecs|eks) +(create-|update-|delete-|put-|deploy)\tchanges deployed infrastructure'
)

# Commands this guard looks at at all, so it stays out of the others' way.
SCOPE='(^|[^[:alnum:]_-])(aws|docker)([^[:alnum:]_-]|$)'
