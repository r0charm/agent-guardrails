# Guards filesystem deletes that git cannot recover. See policy.md.
#
# rm matches no other guard, so `rm -rf .claude/worktrees` slips past every
# check and takes uncommitted work in every worktree with it. This closes that.

ASK=(
  $'(^|[^[:alnum:]_-])rm +.*worktree\tremoves a git worktree by path; any uncommitted work in it is gone and git cannot recover it'
  # Flags in any form, short or long, split or together: `-rf`, `-r -f`,
  # `--recursive`. A single file under .claude with no flag stays silent.
  $'(^|[^[:alnum:]_-])rm +(-[^ ]+ +)+([^ ]+ +)*([^ ]*/)?\\.claude(/|$| )\tdeletes under .claude, which holds worktrees and local agent state'
  # The repository itself, not a file inside it: `rm -f .git/index.lock` is
  # ordinary recovery from a crashed git and stays silent.
  $'(^|[^[:alnum:]_-])rm +(-[^ ]+ +)+([^ ]+ +)*([^ ]*/)?\\.git/?( |;|&|$)\tdeletes the repository: unpushed commits, stashes and the reflog go with it, and nothing recovers them'
  $'(^|[^[:alnum:]_-])find +.*worktree.* -delete\tdeletes matched worktree paths, uncommitted work included'
)

# Commands this guard looks at at all, so it stays out of the others' way.
SCOPE='(^|[^[:alnum:]_-])(rm|rmdir|find)([^[:alnum:]_-]|$)'
