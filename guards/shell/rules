# Guards indirection: commands whose real text is not in the command. See
# policy.md.
#
# Every other guard reads the command it is given. These hand the shell text
# that only exists at run time, a pipe, a variable or a substitution, so no
# other guard can see what will run. Each is an ask, not a verdict on what
# runs: it says the guards are blind here.

# The start of a command: the start of the line, or after a separator.
C='(^|[;&|(]) *'
# The end of a command word.
E='( |;|&|\)|$)'

ASK=(
  $'\\| *(sudo +)?(ba|z|da|k)?sh( +-[a-z]+)*( |;|&|\\)|$)\tpipes text into a shell, so what runs is not in the command the guards read'
  $'\\| *(sudo +)?(python3?|perl|ruby|node)( +-)? *($|[;&)])\tpipes text into an interpreter, so what runs is not in the command the guards read'
  $'(^|[;&|( ])((ba|z)?sh|source|\\.) +<\\(\truns the output of a command as a script, which the guards cannot read'
  "${C}eval +\\\$[A-Za-z_{]"$'\tevaluates a variable as a command, which the guards cannot read'
  "${C}\\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?${E}"$'\truns a command named by a variable, which the guards cannot read'
  "${C}\\\$\\([^)]*\\)${E}"$'\truns a command produced by a substitution, which the guards cannot read'
  "${C}(git|gh|kubectl|helm|terraform|tofu|terragrunt|aws) +\\\$"$'\tgives a guarded tool its subcommand from a variable, so the guard for it cannot read the verb'
)

# A script is full of these, so in one they would ask on almost every file run,
# a prompt people learn to click through. The other guards still read the file.
COMMAND_ONLY=1

# Commands this guard looks at at all, so it stays out of the others' way.
SCOPE='(\||eval|\$|<\()'
